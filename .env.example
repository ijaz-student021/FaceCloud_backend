DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com

# Database: keep sqlite for lightweight local fallback, or use PostgreSQL values below.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=facecloud
DB_USER=facecloud_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

PUBLIC_BACKEND_URL=https://api.example.com
FRONTEND_URL=https://example.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://example.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
SIGNUP_VERIFICATION_CODE_LIFETIME_SECONDS=600
SIGNUP_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
SIGNUP_VERIFICATION_MAX_ATTEMPTS=5
SIGNUP_VERIFICATION_MAX_SENDS_PER_HOUR=5
SIGNUP_VERIFICATION_RETENTION_HOURS=24
SIGNUP_VERIFICATION_SUPPORT_EMAIL=support@example.com
DEFAULT_FROM_EMAIL=noreply@example.com

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Upload limits (bytes unless noted otherwise)
MAX_IMAGE_UPLOAD_SIZE=419430400
MAX_ZIP_UPLOAD_SIZE=2147483648
MAX_UPLOAD_BATCH_FILES=150
MAX_IMAGE_PIXELS=100000000
MAX_ZIP_COMPRESSION_RATIO=100
MAX_ZIP_UNCOMPRESSED_SIZE=5368709120
DOWNLOAD_PACKAGE_TTL_HOURS=24
DOWNLOAD_PACKAGE_MAX_FILES=500
DOWNLOAD_PACKAGE_MAX_UNCOMPRESSED_SIZE=16106127360
DOWNLOAD_PACKAGE_COMPRESSION_LEVEL=6
PREPROCESS_MAX_WIDTH=4096
PREPROCESS_MAX_HEIGHT=4096
PREPROCESS_JPEG_QUALITY=95
PREPROCESS_TRANSPARENT_BACKGROUND="#FFFFFF"

# Optional CPU AI super-resolution. Download EDSR_x2.pb separately into the path below.
AI_RESTORATION_ENABLED=True
AI_RESTORATION_EDSR_MODEL_PATH=.runtime/models/EDSR_x2.pb
ZERO_DCE_ENABLED=True
ZERO_DCE_MODEL_PATH=.runtime/models/zero_dce_epoch99.onnx
ZERO_DCE_MAX_INFERENCE_EDGE=1024
ZERO_DCE_FULL_RESOLUTION_TILE_EDGE=1024
ADAPTIVE_DENOISE_ENABLED=True
ADAPTIVE_DENOISE_BREAKPOINTS=1.0,2.0,3.5,5.0,7.0
ADAPTIVE_DENOISE_STRENGTHS=0,3,4,5,6,7
# Private licensed face-restoration rollout. Keep disabled until the isolated
# Python worker, checkpoint integrity, and consented evaluation set pass QA.
GFPGAN_ENABLED=False
GFPGAN_QUEUE_ENABLED=False
GFPGAN_QUEUE_NAME=gfpgan
GFPGAN_MODEL_PATH=.runtime/models/gfpgan/GFPGANv1.4.pth
GFPGAN_MODEL_SHA256=e2cd4703ab14f4d01fd1383a8a8b266f9a5833dacee8e6a79d3bf21a1b6be5ad
GFPGAN_DETECTION_MODEL_PATH=gfpgan/weights/detection_Resnet50_Final.pth
GFPGAN_DETECTION_MODEL_SHA256=6d1de9c2944f2ccddca5f5e010ea5ae64a39845a86311af6fdf30841b0a5a16d
GFPGAN_PARSING_MODEL_PATH=gfpgan/weights/parsing_parsenet.pth
GFPGAN_PARSING_MODEL_SHA256=3d558d8d0e42c20224f13cf5a29c79eba2d59913419f945545d8cf7b72920de2
GFPGAN_ARCH=clean
GFPGAN_CHANNEL_MULTIPLIER=2
GFPGAN_DEVICE=auto
GFPGAN_RESTORATION_WEIGHT=0.30
GFPGAN_OUTPUT_BLEND=0.25
GFPGAN_MIN_OUTPUT_BLEND=0.08
GFPGAN_ALLOW_MILD_BLUR=True
GFPGAN_MAX_FACES=5
GFPGAN_MAX_INPUT_PIXELS=12000000
GFPGAN_MIN_STRUCTURAL_SIMILARITY=0.90
GFPGAN_MAX_MEAN_ABSOLUTE_CHANGE=12.0
GFPGAN_MAX_P95_ABSOLUTE_CHANGE=42.0
GFPGAN_MAX_CHROMA_SHIFT=3.0
GFPGAN_MAX_HIGHLIGHT_CLIPPING_GROWTH=1.0
PER_FACE_METRICS_ENABLED=False
IDENTITY_EMBEDDING_ENABLED=False
ENHANCEMENT_PRESERVE_ORIGINAL_RESOLUTION=True
ENHANCEMENT_MODEL_LUMINANCE_THRESHOLD=0.45
ENHANCEMENT_MODEL_LUMINANCE_TARGET=0.60
ENHANCEMENT_MAX_HIGHLIGHT_CLIPPING_PERCENT=5.0
AI_RESTORATION_SCALE=2
AI_RESTORATION_MAX_INPUT_EDGE=480
AI_RESTORATION_MAX_OUTPUT_PIXELS=20000000

# Image-quality decision thresholds
QUALITY_IDEAL_LUMINANCE=135
QUALITY_SHARPNESS_TARGET=150
QUALITY_CONTRAST_TARGET=55
QUALITY_MAX_NOISE=12
QUALITY_MAX_TOTAL_CLIPPING=20
QUALITY_RESOLUTION_TARGET=720
QUALITY_REJECT_SHARPNESS=20
QUALITY_REVIEW_SHARPNESS=60
QUALITY_REJECT_MIN_EDGE=240
QUALITY_REVIEW_MIN_EDGE=480
QUALITY_REJECT_MIN_LUMINANCE=25
QUALITY_REVIEW_MIN_LUMINANCE=55
QUALITY_REJECT_MAX_LUMINANCE=235
QUALITY_REVIEW_MAX_LUMINANCE=210
QUALITY_REJECT_CONTRAST=12
QUALITY_REVIEW_CONTRAST=20
QUALITY_REVIEW_NOISE=10
QUALITY_ACCEPT_SCORE=60

# Owner-scoped duplicate detection
DUPLICATE_AUTO_ANALYZE=True
DUPLICATE_PERCEPTUAL_HASH_DISTANCE=8
DUPLICATE_FACE_HASH_DISTANCE=6
DUPLICATE_MAX_CANDIDATES=5000

# Background preprocessing (set eager=True only for local debugging without Redis)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
NOTIFICATION_EMAILS_ENABLED=True
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_EMAIL_MAX_RETRIES=3
BATCH_PROGRESS_MAX_RETRIES=3
