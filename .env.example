DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com

# Database: keep sqlite for lightweight local fallback, or use PostgreSQL values below.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=facecloud
DB_USER=facecloud_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Public addresses. PUBLIC_BACKEND_URL is this API as the outside world reaches it. FRONTEND_URL is where the web app lives:
# the signup verification link ({FRONTEND_URL}/verify-email?registration_id=...&token=...), the password-reset link and
# organization invitations all point at it. Its development default is http://localhost:5173 (the frontend dev server); production
# refuses to start unless it is a real https address (not localhost or 127.0.0.1). The same rule applies to PUBLIC_BACKEND_URL,
# whose development default is http://127.0.0.1:8000: share links' public_url is built from it.
PUBLIC_BACKEND_URL=https://api.example.com
FRONTEND_URL=https://example.com
# Cross-origin access for the browser app. CORS_ALLOW_ALL_ORIGINS defaults to True only while DJANGO_DEBUG=True; keep it False in
# production and list the frontend origin(s) (comma-separated, https) in CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://example.com
# Reverse proxies in front of Django (0 = none). X-Forwarded-For is trusted only for
# this many hops, so throttling and the audit log cannot be spoofed with a header.
TRUSTED_PROXY_COUNT=1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
FACECLOUD_VERSION=dev
SYSTEM_HEALTH_TIMEOUT_SECONDS=1.0
# GET /api/system/health/ runs its checks together and waits at most this long for all of them (a slower one is reported as a timeout), and keeps the finished answer this many seconds (0: off).
SYSTEM_HEALTH_DEADLINE_SECONDS=2.0
SYSTEM_HEALTH_CACHE_SECONDS=5
# How long the emailed verification link stays valid (seconds). The link works once.
SIGNUP_VERIFICATION_LINK_LIFETIME_SECONDS=86400
SIGNUP_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
SIGNUP_VERIFICATION_MAX_ATTEMPTS=5
SIGNUP_VERIFICATION_MAX_SENDS_PER_HOUR=5
SIGNUP_VERIFICATION_RETENTION_HOURS=24
SIGNUP_VERIFICATION_SUPPORT_EMAIL=support@example.com
DEFAULT_FROM_EMAIL=noreply@example.com

SECURE_SSL_REDIRECT=True
# Instead of the redirect, when a reverse proxy terminates TLS and sets X-Forwarded-Proto:
# TRUST_PROXY_SSL_HEADER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Upload limits (bytes unless noted otherwise)
MAX_IMAGE_UPLOAD_SIZE=419430400
MAX_ZIP_UPLOAD_SIZE=2147483648
MAX_UPLOAD_BATCH_FILES=150
MAX_IMAGE_PIXELS=100000000
MAX_ZIP_COMPRESSION_RATIO=100
MAX_ZIP_UNCOMPRESSED_SIZE=5368709120
DOWNLOAD_PACKAGE_TTL_HOURS=24
DOWNLOAD_PACKAGE_MAX_FILES=500
DOWNLOAD_PACKAGE_MAX_UNCOMPRESSED_SIZE=16106127360
DOWNLOAD_PACKAGE_COMPRESSION_LEVEL=6
PREPROCESS_MAX_WIDTH=4096
PREPROCESS_MAX_HEIGHT=4096
PREPROCESS_JPEG_QUALITY=95
PREPROCESS_TRANSPARENT_BACKGROUND="#FFFFFF"
# Enlarge a very small photograph (shorter side under SMALL_IMAGE_ENLARGE_BELOW_EDGE, default 240 = the line under which the quality check refuses it for
# its size) 2 or 4 times while it is standardized, so it is not refused and the later stages can work (a picture under a quarter of that line, 60 px, is left
# alone: even 4 times would not rescue it). ON by default (the line below only makes it explicit).
# To turn it off set it to False and restart (photographs already enlarged stay as they are). Engine: auto (Real-ESRGAN when HD_RESTORATION_ENABLED is on,
# else OpenCV Lanczos), realesrgan (never silently OpenCV) or opencv (invents no detail). docs/evaluation/2026-11-02-small-image-enlargement.md
SMALL_IMAGE_ENLARGE_ENABLED=True
SMALL_IMAGE_ENLARGE_BELOW_EDGE=240
SMALL_IMAGE_ENLARGE_TARGET_EDGE=480
SMALL_IMAGE_ENLARGE_ENGINE=auto
SMALL_IMAGE_ENLARGE_MIN_CONSISTENCY_DB=30

# Optional CPU AI super-resolution. Download EDSR_x2.pb separately into the path below.
AI_RESTORATION_ENABLED=True
AI_RESTORATION_EDSR_MODEL_PATH=.runtime/models/EDSR_x2.pb
# Model set (2026-10). Each model is off unless its flag is on AND the rendering policy allows it
# (ENHANCEMENT_RENDER_POLICY=learned_v1 runs every model whose flag is on; the editor sliders only need the flag).
# Retinexformer: low light (MIT). NAFNet-SIDD: real-noise denoising. NAFNet-GoPro: motion deblur.
# CodeFormer: face restoration (S-Lab licence, NON-COMMERCIAL). KEEP IT OFF until identity preservation is validated
# on a larger set of faces (docs/enhancement/adaptive-engine.md section 4a). Real-ESRGAN: super-resolution via HD_RESTORATION_ENABLED.
#
# THE THREE THAT DECIDE WHAT A PHOTOGRAPH CAN HAVE REMOVED (all off here; each is set again with its path and checksum below, so this block is only a summary):
#   NAFNET_DEBLUR_ENABLED=False   blur removal       NAFNet-GoPro, MIT code (the checkpoint and its training data: docs/model-licenses/commercial-inventory-2026-10.md)
#   CODEFORMER_ENABLED=False      face restoration   CodeFormer, S-Lab License 1.0: NON-COMMERCIAL. Needs the person's face-processing consent (/api/privacy/consents/).
#   GFPGAN_ENABLED=False          face restoration   GFPGAN v1.4, non-commercial, and it needs its own isolated Python worker (GFPGAN_QUEUE_ENABLED): leave it off unless that worker exists.
#   NONCOMMERCIAL_MODELS_ACKNOWLEDGED=False   production start-up refuses CodeFormer, GFPGAN, ArcFace, RetinaFace and Zero-DCE until the owner sets this True: it records a decision, it is not a licence
#                                             and it is ONE switch for all of them. Whether to switch them on is the owner's decision; the code defaults stay off.
# A ready-made profile that switches the demonstration set on, with the limits that keep a photograph fast: .env.demo.example (README, "Demonstration profile").
# With the flags on, `python manage.py check_restoration --require deblur face_restore upscale` shows which stages can run, and GET /api/system/health/ (admin) lists "stages".
RETINEXFORMER_ENABLED=False
RETINEXFORMER_MODEL_PATH=.runtime/models/Retinexformer_NTIRE.pth
RETINEXFORMER_MODEL_SHA256=ba460a6882090ff3312c11fe96b3e7dc5be8e013b8c3b3a7ef6a529cc5ff27fa
# A photograph whose long edge is over this is brightened in ONE pass on a reduced copy and the gain is applied to the full-size photograph (tiles show seams
# and a large tile does not fit an 8 GB machine). 0 = run the network tile by tile at the full size.
RETINEXFORMER_WORK_EDGE=960
NAFNET_DENOISE_ENABLED=False
NAFNET_SIDD_MODEL_PATH=.runtime/models/NAFNet-SIDD-width64.pth
NAFNET_SIDD_MODEL_SHA256=cd685efaae01f7c4e9951f2deab05780079c8eb1e49ed664b72f6db04dabb445
NAFNET_DEBLUR_ENABLED=False
CODEFORMER_ENABLED=False
CODEFORMER_MODEL_PATH=.runtime/models/codeformer/codeformer.pth
CODEFORMER_MODEL_SHA256=1009e537e0c2a07d4cabce6355f53cb66767cd4b4297ec7a4a64ca4b8a5684b7
CODEFORMER_FIDELITY=0.7
# The adaptive engine's face-restoration attempts (CodeFormer fidelity weights; every value costs one pass) and the identity limit a restored face must meet against the upload (SFace cosine; 0.80 = the earlier limit).
# Measured on the owner's photographs: docs/evaluation/2026-11-04-face-fidelity.md.
ADAPTIVE_FACE_FIDELITIES=1.0
SFACE_RESTORE_GUARD_MIN_SIMILARITY=0.65
ZERO_DCE_ENABLED=True
ZERO_DCE_MODEL_PATH=.runtime/models/zero_dce_epoch99.onnx
# Official Epoch99 weights exported under PyTorch 2.13.0; see docs/model-licenses/zero-dce-provenance.md.
ZERO_DCE_MODEL_SHA256=e5cb6f921c7997f89105f6aa86242f30ff3f5379f5c6cd5282eb2aada14dae14
ZERO_DCE_MAX_INFERENCE_EDGE=1024
ZERO_DCE_FULL_RESOLUTION_TILE_EDGE=1024
ADAPTIVE_DENOISE_ENABLED=True
ADAPTIVE_DENOISE_BREAKPOINTS=1.0,2.0,3.5,5.0,7.0,9.0
ADAPTIVE_DENOISE_STRENGTHS=0,3,4,7,10,13,16
DENOISE_MIN_NOISE_REMOVED=1.0
DENOISE_MIN_NOISE_REDUCTION=0.30
DENOISE_MIN_RESIDUAL_WHITENESS=3.0
DENOISE_MIN_DETAIL_RETENTION=0.85
DENOISE_MIN_EDGE_RETENTION=0.85
# Lifts the photo's own colour in very dark photos after brightening (effective boost is the
# square root of this cap, so 9 means at most 3x). 1 or less switches it off.
ENHANCEMENT_DARK_COLOUR_GAIN_MAX=9.0
# Private licensed face-restoration rollout. Keep disabled until the isolated
# Python worker, checkpoint integrity, and consented evaluation set pass QA.
GFPGAN_ENABLED=False
# Face restoration runs only when its result can be compared with a source face.
GFPGAN_REQUIRE_IDENTITY_CHECK=True
GFPGAN_QUEUE_ENABLED=False
GFPGAN_QUEUE_NAME=gfpgan
GFPGAN_MODEL_PATH=.runtime/models/gfpgan/GFPGANv1.4.pth
GFPGAN_MODEL_SHA256=e2cd4703ab14f4d01fd1383a8a8b266f9a5833dacee8e6a79d3bf21a1b6be5ad
GFPGAN_DETECTION_MODEL_PATH=gfpgan/weights/detection_Resnet50_Final.pth
GFPGAN_DETECTION_MODEL_SHA256=6d1de9c2944f2ccddca5f5e010ea5ae64a39845a86311af6fdf30841b0a5a16d
GFPGAN_PARSING_MODEL_PATH=gfpgan/weights/parsing_parsenet.pth
GFPGAN_PARSING_MODEL_SHA256=3d558d8d0e42c20224f13cf5a29c79eba2d59913419f945545d8cf7b72920de2
GFPGAN_ARCH=clean
GFPGAN_CHANNEL_MULTIPLIER=2
GFPGAN_DEVICE=auto
GFPGAN_RESTORATION_WEIGHT=0.30
GFPGAN_OUTPUT_BLEND=0.25
GFPGAN_MIN_OUTPUT_BLEND=0.08
GFPGAN_ALLOW_MILD_BLUR=True
GFPGAN_MAX_FACES=5
GFPGAN_MAX_INPUT_PIXELS=12000000
GFPGAN_MIN_STRUCTURAL_SIMILARITY=0.90
GFPGAN_MAX_MEAN_ABSOLUTE_CHANGE=12.0
GFPGAN_MAX_P95_ABSOLUTE_CHANGE=42.0
GFPGAN_MAX_CHROMA_SHIFT=3.0
GFPGAN_MAX_HIGHLIGHT_CLIPPING_GROWTH=1.0
PER_FACE_METRICS_ENABLED=False
# Per-face fidelity check against the image before restoration and sharpening.
FACE_FIDELITY_ENABLED=True
FACE_FIDELITY_MIN_STRUCTURAL_SIMILARITY=0.85
FACE_FIDELITY_MIN_TEXTURE_RETENTION=0.60
FACE_FIDELITY_MAX_TEXTURE_GAIN=1.80
FACE_FIDELITY_MAX_CHROMA_SHIFT=4.0
FACE_FIDELITY_MAX_HIGHLIGHT_CLIPPING_GROWTH=1.0
IDENTITY_EMBEDDING_ENABLED=False
FACE_DETECTOR_PROVIDER=haar_v1
YUNET_MODEL_PATH=.runtime/models/yunet_s_dynamic.onnx
YUNET_MODEL_SHA256=
# A face is refused as too small only when it is both a small share of the frame and fewer than this many pixels on its shorter edge.
FACE_MIN_EDGE_PIXELS=160
YUNET_SCORE_THRESHOLD=0.75
YUNET_NMS_THRESHOLD=0.3
YUNET_TOP_K=5000
ENHANCEMENT_PRESERVE_ORIGINAL_RESOLUTION=True
# Sources above this many pixels are reduced before enhancement (0 = no limit).
ENHANCEMENT_MAX_INPUT_PIXELS=24000000
ENHANCEMENT_MAX_ENCODING_ERROR=4.0
# Seconds a worker's claim on a result lasts without being refreshed.
ENHANCEMENT_CLAIM_LEASE_SECONDS=1800
ENHANCEMENT_MODEL_LUMINANCE_THRESHOLD=0.45
ENHANCEMENT_MODEL_LUMINANCE_TARGET=0.60
ENHANCEMENT_MAX_HIGHLIGHT_CLIPPING_PERCENT=5.0
AI_RESTORATION_SCALE=2
AI_RESTORATION_MAX_INPUT_EDGE=480
AI_RESTORATION_MAX_OUTPUT_PIXELS=20000000
HD_RESTORATION_ENABLED=False
NAFNET_DEBLUR_ENABLED=False
NAFNET_MODEL_PATH=.runtime/models/NAFNet-GoPro-width64.pth
NAFNET_MODEL_SHA256=329d3ab4077b8d6b7ff61de376e483714667960bf85be027bf4335cda701196f
REALESRGAN_MODEL_PATH=.runtime/models/RealESRGAN_x4plus.pth
REALESRGAN_MODEL_SHA256=4fa0d38905f75ac06eb49a7951b426670021be3018265fd191d2125df9d682f1
HD_RESTORATION_DEVICE=auto
HD_RESTORATION_OUTPUT_SCALE=2
REALESRGAN_OUTPUT_BLEND=0.35
HD_RESTORATION_TILE_SIZE=256
HD_RESTORATION_TILE_OVERLAP=24
NAFNET_MAX_MEAN_CHROMA_SHIFT=8.0
NAFNET_MAX_MEAN_LUMINANCE_SHIFT=30.0
HD_RESTORATION_MAX_NATIVE_OUTPUT_PIXELS=20000000
HD_RESTORATION_MAX_OUTPUT_PIXELS=20000000
# Out-of-memory retries for tiled models: each halves the tile edge.
ENHANCEMENT_OOM_MAX_RETRIES=2
ENHANCEMENT_MIN_TILE_SIZE=64

# Image-quality decision thresholds
QUALITY_IDEAL_LUMINANCE=135
QUALITY_SHARPNESS_TARGET=150
QUALITY_CONTRAST_TARGET=55
QUALITY_MAX_NOISE=12
QUALITY_MAX_TOTAL_CLIPPING=20
QUALITY_RESOLUTION_TARGET=720
QUALITY_REJECT_SHARPNESS=20
QUALITY_REVIEW_SHARPNESS=60
QUALITY_REJECT_MIN_EDGE=240
QUALITY_REVIEW_MIN_EDGE=480
QUALITY_REJECT_MIN_LUMINANCE=6
QUALITY_REVIEW_MIN_LUMINANCE=55
QUALITY_REJECT_MAX_LUMINANCE=235
QUALITY_REVIEW_MAX_LUMINANCE=210
QUALITY_REJECT_CONTRAST=12
QUALITY_REVIEW_CONTRAST=20
QUALITY_REVIEW_NOISE=10
QUALITY_ACCEPT_SCORE=60

# Owner-scoped duplicate detection
DUPLICATE_AUTO_ANALYZE=True
DUPLICATE_PERCEPTUAL_HASH_DISTANCE=8
DUPLICATE_FACE_HASH_DISTANCE=6
DUPLICATE_MAX_CANDIDATES=5000

# Feature 18 remains disabled until an approved local model and calibrated
# thresholds are supplied.
# On: a photograph is filed into a person folder after its quality verdict (accepted: at once; rejected: never; needs review: after a moderator
# approves it, or at once in a personal workspace).
IDENTITY_AUTO_ANALYZE=False
# Person folders take at most this many faces of one photograph (the largest usable ones); the rest are recorded as skipped and the photograph is still accepted.
IDENTITY_MAX_FACES_PER_IMAGE=20
# Trash: days a deleted-with-undo photograph stays restorable before the daily task uploads.purge_trash deletes it for good (1-3650).
TRASH_RETENTION_DAYS=30
# Places: read the GPS position of uploaded photographs (on by default; off reads nothing). Place names need the offline GeoNames file (python scripts/fetch_gazetteer.py), its
# SHA-256 below and the owner's approval of docs/model-licenses/location-gazetteer.md; coordinates are never sent to another service.
LOCATION_ENABLED=True
# LOCATION_GAZETTEER_DIR=.runtime/data/geonames
# LOCATION_GAZETTEER_SHA256=
# LOCATION_MAX_DISTANCE_KM=50
# Search by what is in the photograph ("beach", "red car"). OFF by default. Needs `pip install -r requirements-semantic.txt`, the approved model files in
# SEMANTIC_SEARCH_MODEL_DIR and their SHA-256 (docs/model-licenses/semantic-search-model.md). English only. Then run `python manage.py index_semantic_search`.
SEMANTIC_SEARCH_ENABLED=False
# SEMANTIC_SEARCH_MODEL_DIR=.runtime/models/siglip-vit-b-16
# SEMANTIC_SEARCH_MODEL_SHA256=
# SEMANTIC_SEARCH_DEVICE=auto
# SEMANTIC_SEARCH_MIN_SCORE=0.10
IDENTITY_PROVIDER=disabled
IDENTITY_MODEL_PATH=.runtime/models/face_recognition_sface_2021dec.onnx
IDENTITY_MODEL_SHA256=
IDENTITY_LICENSE_RECORD_PATH=
IDENTITY_EMBEDDING_DIMENSION=128
# Grouping limits for SFace (cosine similarity of a face with a folder's average face), measured with `python manage.py evaluate_identity_thresholds`
# (docs/evaluation/2026-10-19-sface-thresholds.md): below NEW_GROUP a face is clearly not that person and opens a folder; from MATCH up, and at least MARGIN
# ahead of the runner-up, it joins the folder; in between it waits for review. GUARD is the enhancement identity guard, MERGE_SUGGESTION the Identity Review screen.
SFACE_NEW_GROUP_THRESHOLD=0.36
SFACE_MATCH_THRESHOLD=0.45
SFACE_AMBIGUITY_MARGIN=0.06
SFACE_GUARD_MIN_SIMILARITY=0.80
SFACE_MERGE_SUGGESTION_MIN_SIMILARITY=0.40
# The generic limits are only for a provider with none of its own. MODERATOR_MERGE_SUGGESTION_MIN_SIMILARITY, when set, overrides the provider's merge figure.
IDENTITY_MATCH_THRESHOLD=0.82
IDENTITY_NEW_GROUP_THRESHOLD=0.68
IDENTITY_AMBIGUITY_MARGIN=0.06
IDENTITY_MAX_CANDIDATE_GROUPS=1000
IDENTITY_POLICY_VERSION=identity_policy_v1
# Production requires a dedicated 32+ character secret here (never reuse
# DJANGO_SECRET_KEY). Left blank it falls back to DJANGO_SECRET_KEY, and
# `manage.py check --deploy` reports it as an error.
IDENTITY_EMBEDDING_KEY=
# Key rotation: bump the id when you change the key, and list retired keys as
# "id:secret,id:secret" until `manage.py reencrypt_identity_embeddings` finishes.
IDENTITY_EMBEDDING_KEY_ID=1
IDENTITY_EMBEDDING_PREVIOUS_KEYS=

# Encrypt stored images at rest (AES-256-GCM). Required in production. Needs its own
# key of 32+ characters (never DJANGO_SECRET_KEY); generate one with
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# See docs/features/stored-image-encryption.md, including converting existing files.
IMAGE_ENCRYPTION_ENABLED=True
IMAGE_ENCRYPTION_KEY=
IMAGE_ENCRYPTION_KEY_ID=1
IMAGE_ENCRYPTION_PREVIOUS_KEYS=

# Feature 41: biometric privacy controls. Turn consent enforcement on and set a
# retention period for production (see docs/features/41-privacy-and-facial-data.md).
BIOMETRIC_CONSENT_REQUIRED=False
BIOMETRIC_CONSENT_POLICY_VERSION=2026-09-v1
FACIAL_DATA_RETENTION_DAYS=0
PRIVACY_EXPORT_MAX_ROWS=2000
# Temporary-file cleanup (run `manage.py cleanup_temporary_files` on a schedule).
# The temp age limit must exceed CELERY_TASK_TIME_LIMIT. Orphaned media is only
# reported unless deletion is enabled here or with --delete-orphans.
TEMP_FILE_MAX_AGE_HOURS=6
ORPHAN_MEDIA_GRACE_HOURS=24
ORPHAN_MEDIA_CLEANUP_ENABLED=False

# Request rates can be changed without code: THROTTLE_RATE_<SCOPE>=N/second|minute|hour|day. The login rate is per address (default 20/hour), so
# a demo where many people sign in from one network may need more. Production refuses a login rate above 100/hour. Leave unset normally.
# Sign-in counts failed attempts only (per address + account name), so a room sharing one address is not locked out; see docs/deployment/rate-limits.md for
# the values to use on a demo day (the anonymous scopes: ANON, REGISTRATION, VERIFICATION, VERIFICATION_STATUS, PASSWORD_RESET, INVITATION).
# THROTTLE_RATE_ANON=5000/hour

# Per-account login backoff: lock after N failures, doubling from BASE to MAX seconds.
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_BASE_SECONDS=30
LOGIN_LOCK_MAX_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900

# Job recovery and fair use (see docs/features/20-background-job-operations.md).
# A processing job unchanged for the task time limit + grace has lost its worker.
JOB_PROCESSING_STALE_SECONDS=4200
JOB_QUEUED_STALE_HOURS=6
# Active work one user may have at once (0 disables the limit).
MAX_ACTIVE_ENHANCEMENTS_PER_USER=10
MAX_ACTIVE_BATCH_ENHANCEMENTS_PER_USER=2

# Model comparison (Feature 35): preview size, concurrent limit, retention in days.
COMPARISON_MAX_EDGE=1280
MAX_ACTIVE_COMPARISONS_PER_USER=2
COMPARISON_RETENTION_DAYS=7

# Share links (Feature 26). TTLs are in hours; 0 removes the per-user cap.
SHARE_LINK_DEFAULT_TTL_HOURS=24
SHARE_LINK_MAX_TTL_HOURS=720
SHARE_LINK_MAX_ACTIVE_PER_USER=50
SHARE_LINK_RETENTION_DAYS=30

# Photo thumbnails, generated on first request: allowed longest edges in pixels
# (the first is the default) and JPEG quality.
THUMBNAIL_SIZES=256,1024
THUMBNAIL_JPEG_QUALITY=80
# Make the default-size thumbnail in the background right after upload.
THUMBNAIL_PREGENERATE=True


# Feature 48: hours between two photos that starts a new event in the timeline.
EVENT_GAP_HOURS=6

# Organizations and the moderator area (TTLs in hours).
ORG_INVITATION_TTL_HOURS=72
# How many moderators / plain members each plan allows (a number, or "unlimited"). Defaults: free 1 / 10, team 5 / 100, enterprise unlimited.
# ORG_PLAN_FREE_MODERATORS=1
# ORG_PLAN_FREE_MEMBERS=10
# ORG_PLAN_TEAM_MODERATORS=5
# ORG_PLAN_TEAM_MEMBERS=100
# ORG_PLAN_ENTERPRISE_MODERATORS=unlimited
# ORG_PLAN_ENTERPRISE_MEMBERS=unlimited
ORGANIZATION_EXPORT_MAX_ROWS=2000
ORGANIZATION_EXPORT_TTL_HOURS=24
MODERATOR_REPORT_TTL_HOURS=24

# Moderation queue service levels and locking.
MODERATION_SLA_HOURS=24
MODERATION_SLA_DUE_SOON_HOURS=4
MODERATION_CLAIM_MINUTES=15
MODERATION_BULK_MAX_REVIEWS=50
MODERATION_METRICS_MAX_DAYS=365

# Background preprocessing. True runs every task inside the web request (no worker, no progress: the server logs a warning, /api/system/health/ says
# background_jobs_inline, uploads answer processing_mode=inline); use it only for local debugging without Redis. Unset, it follows DJANGO_DEBUG.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Shared cache for rate limits; required in production (per-process otherwise).
CACHE_URL=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_TASK_TIME_LIMIT=3600
# Must exceed CELERY_TASK_TIME_LIMIT + ENHANCEMENT_CLAIM_LEASE_SECONDS, or a task
# that waits for a claim and then runs long is delivered twice. Default: both
# plus 15 minutes.
CELERY_VISIBILITY_TIMEOUT=6300
CELERY_TASK_SOFT_TIME_LIMIT=3300
NOTIFICATION_EMAILS_ENABLED=True
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_EMAIL_MAX_RETRIES=3
BATCH_PROGRESS_MAX_RETRIES=3

# Public contact form: comma-separated recipients (empty: the form answers 503).
CONTACT_RECIPIENT_EMAILS=support@your-domain.example
CONTACT_MESSAGE_RETENTION_DAYS=180

# Optional cloud adjustment advisor (disabled by default). When enabled, a bounded
# preview of the image (no metadata) plus measured diagnostics is sent to OpenAI
# only after the user's separate consent. Keep the key in a secret store; never
# commit it. OPENAI_ADVISOR_MODEL has no default: choose an image-capable model.
OPENAI_ADVISOR_ENABLED=false
OPENAI_API_KEY=
OPENAI_ADVISOR_MODEL=

# Enhancement policy: lightweight_v1 (default, OpenCV and Pillow only) | balanced_v1 (adds Zero-DCE on the CPU when a
# lift is requested) | learned_v1 (every model whose own setting is on). See docs/enhancement/optional-models.md.
ENHANCEMENT_RENDER_POLICY=lightweight_v1
# Automatic enhancement after upload (enhancement/auto.py): photographs that pass the checks are enhanced without anyone asking. AUTO_ENHANCEMENT_ENABLED is the
# operator's switch (a person can also turn it off: `auto_enhance` on the account and on an upload). AUTO_ENHANCEMENT_RENDER_POLICY is the policy those runs use
# (adaptive_v1: "original preserved" when nothing safe helps); a person's own request keeps ENHANCEMENT_RENDER_POLICY. It changes no model setting, and the
# production guard counts it: Zero-DCE under it needs NONCOMMERCIAL_MODELS_ACKNOWLEDGED. A photograph that cannot start because its owner is at the limit of
# enhancements in progress waits, and is skipped (never failed) after AUTO_ENHANCEMENT_CAPACITY_WAIT_MINUTES.
AUTO_ENHANCEMENT_ENABLED=True
AUTO_ENHANCEMENT_RENDER_POLICY=adaptive_v1
AUTO_ENHANCEMENT_CAPACITY_WAIT_MINUTES=180
# Gentle noise reduction before a requested lift of a dark photo: off | chroma | nlm
ENHANCEMENT_PREFILTER_MODE=chroma

# Private object storage (Feature 43). filesystem keeps media on local disk (the default). s3 keeps every stored
# file in a private S3 bucket, encrypted client-side first when IMAGE_ENCRYPTION_ENABLED=True.
# Credentials: an IAM role, or an IAM user's keys through the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# variables. NEVER the AWS account's root keys. Create the bucket with scripts/aws_provision_bucket.py, then run
# python manage.py check_storage. See docs/deployment/aws-s3-private-storage.md.
STORAGE_BACKEND=filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_KEY_PREFIX=media
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_S3_KMS_KEY_ID=

# The adaptive engine (ENHANCEMENT_RENDER_POLICY=adaptive_v1): bounds, and development-only debug artifacts (never on in production).
ADAPTIVE_MAX_CANDIDATES=8
ADAPTIVE_TIME_BUDGET_SECONDS=180
ADAPTIVE_MAX_OUTPUT_EDGE=4096
ADAPTIVE_DEBUG_ARTIFACTS=False
# A gentle "polish" (OpenCV only, no model) for a photograph on which the engine found nothing to fix. OFF unless True: with it off, or the
# line absent, the engine behaves exactly as before. To turn it on, add ADAPTIVE_POLISH_ENABLED=True and restart; to turn it off, delete
# the line (or set False) and restart. docs/enhancement/adaptive-engine.md section 5a.
ADAPTIVE_POLISH_ENABLED=False
# Every photograph is enhanced (default True). A photograph on which no defect was found goes through the detail model used for light photographs (the compact
# "general" network, if HD_RESTORATION_ENABLED), and through a finishing polish when that model's result is refused, or when the photograph is over
# ADAPTIVE_DETAIL_MAX_PIXELS; a corrective step the safety gates refused no longer keeps the photograph from the finish. Every safety gate (identity, face geometry, halo,
# clipping, colour) still applies. False: a photograph that needs nothing is returned as it was (and polish needs ADAPTIVE_POLISH_ENABLED).
ADAPTIVE_ALWAYS_ENHANCE=True
ADAPTIVE_FINISH_STRENGTH=3.0
ADAPTIVE_FINISH_VIBRANCE=0.15
ADAPTIVE_FINISH_TOLERANCE=0.97
ADAPTIVE_FINISH_MIN_CHANGE=1.5
# The final layer (the light-photo model on every photograph, after everything else) is applied unless it smooths the photograph by more than this allows (structure energy x0.75)
# or changes nothing visible (mean change under 0.5 of 255).
ADAPTIVE_REFINE_MIN_GAIN=0.75
ADAPTIVE_REFINE_MIN_CHANGE=0.5
# A face's landmark jitter under this many pixels of the ORIGINAL photograph is detector noise on a tiny face, not a changed face (0 = off).
ADAPTIVE_LANDMARK_PIXEL_FLOOR=2.0
# DDColor (Apache-2.0) colourizes a black-and-white photograph for the dynamic and ai_max styles. OFF unless True. The checkpoint is pinned by checksum
# (docs/model-licenses/ddcolor.md): download piddnad/ddcolor_paper pytorch_model.bin to .runtime/models/ddcolor/ddcolor_paper.bin. "large" is the default;
# "tiny" turned teeth orange on the owner's portrait. The three natural-colour numbers are measured (docs/evaluation/2026-11-03-colourization.md).
DDCOLOR_ENABLED=False
DDCOLOR_MODEL_VARIANT=large
DDCOLOR_CHROMA_SCALE=0.7
DDCOLOR_DARK_DAMPING=0.3
DDCOLOR_HIGHLIGHT_DAMPING=0.5
# Detail restoration: a soft or heavily compressed photograph (a WhatsApp copy) comes out clearer at the SAME size (docs/evaluation/2026-11-03-detail-restoration.md).
# On by default when HD restoration is on; ADAPTIVE_DETAIL_MAX_PIXELS leaves a larger photograph alone (about 3 s per megapixel with the compact model).
# A failed quality check never refuses a photograph (it is enhanced; the reasons become tips). True restores the old refusals. docs/evaluation/2026-11-03-enhance-every-photograph.md
QUALITY_CHECKS_REJECT=False
# The face detector runs at two sizes and merges them, so a large face in a large photograph is found (it was missed at full size).
YUNET_MAX_EDGE=2048
YUNET_LARGE_FACE_EDGE=1024
ADAPTIVE_DETAIL_ENABLED=True
ADAPTIVE_DETAIL_MAX_PIXELS=4000000
# The slow detail networks (Real-ESRGAN x4plus, 4x-UltraSharp) as the FALLBACK after the compact one was refused are skipped above this many pixels (about 3 s + 42 s per megapixel on a GPU, minutes on a CPU); 0 = no limit.
ADAPTIVE_SLOW_DETAIL_MAX_PIXELS=500000
# 4x-UltraSharp (CC BY-NC-SA 4.0, docs/model-licenses/ultrasharp.md): the best-looking detail engine, about thirty times slower than the compact one; AI Enhance and the Strong level
# prefer it when it is on. Put the official 4x-UltraSharp.pth (sha256 a5812231...) in .runtime/models/ultrasharp/. OFF unless True.
ULTRASHARP_ENABLED=False
# chromaticity (default) or legacy: how a low-light lift gets its colour (see docs/evaluation/2026-10-15-lowlight-colour.md)
ADAPTIVE_LOWLIGHT_COLOUR=chromaticity
# Production refuses models without a verified commercial licence (CodeFormer, GFPGAN, ArcFace, RetinaFace, Zero-DCE under a learned policy)
# unless this is True: set it only after the licence position is decided (docs/model-licenses/model-set-2026-10.md)
NONCOMMERCIAL_MODELS_ACKNOWLEDGED=False
ADAPTIVE_DEBUG_RETENTION_HOURS=24
# Which large models stay loaded: single (one at a time), all, or auto (single on a machine with under 12 GiB of memory).
ENHANCEMENT_MODEL_RESIDENCY=auto

# Run model inference on its own worker pool: set a queue name and start `celery -A config worker -Q <name> --concurrency=1` apart from the API
# (empty = the default queue). See docs/deployment/hostinger-readiness-2026-10.md
ENHANCEMENT_QUEUE_NAME=
# Gallery edits ("Save as new version") on a queue of their own, with their own worker (`celery -A config worker -Q <name> --concurrency=1`), so a
# save never waits behind a batch enhancement. Set it in the API's and the workers' environment alike. Empty = edits stay where they were.
ENHANCEMENT_EDIT_QUEUE_NAME=

# Logging: INFO and above from the application go to the console; set LOG_FILE to also keep a rotating file (5 MB x 5).
LOG_LEVEL=INFO
LOG_FILE=
