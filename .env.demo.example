# Demonstration profile: switches the restoration stages ON and keeps every photograph fast. Not for production (the production guard needs the decisions below on the record).
#
#   cp .env.example .env            # once, then edit the keys (DJANGO_SECRET_KEY, IDENTITY_EMBEDDING_KEY, ...)
#   cat .env.demo.example >> .env   # the later line wins, so these override the defaults above them
#   python manage.py check_restoration --require deblur face_restore upscale
#   bash scripts/dev_up.sh
#
# Models: the checkpoints must be in .runtime/models/ (python scripts/fetch_models.py; the paths and SHA-256 pins are in .env.example). Each adapter refuses a file whose checksum does not match.

# The engine the product was built and tested on
ENHANCEMENT_RENDER_POLICY=adaptive_v1
AUTO_ENHANCEMENT_RENDER_POLICY=adaptive_v1

# Stages that are OFF by default and are switched on here (licences: NAFNet MIT code; CodeFormer S-Lab 1.0 NON-COMMERCIAL; Zero-DCE CC BY-NC 4.0 weights; Real-ESRGAN BSD-3)
NAFNET_DEBLUR_ENABLED=True
CODEFORMER_ENABLED=True
HD_RESTORATION_ENABLED=True
ZERO_DCE_ENABLED=True
# GFPGAN stays off: it needs an isolated Python worker of its own, and CodeFormer already does face restoration.
GFPGAN_ENABLED=False
# The owner's decision to run non-commercial models for the demonstration (docs/model-licenses/zero-dce-owner-decision.md). One switch for all of them; not a licence.
NONCOMMERCIAL_MODELS_ACKNOWLEDGED=True

# Every photograph is enhanced, and what that costs (measured 2026-11-03 on an M1 / 8 GB at a 1400 px long edge: 3 to 10 s for the usual photograph, 40 to 47 s with deblur + face restoration)
ADAPTIVE_ALWAYS_ENHANCE=True
ADAPTIVE_POLISH_ENABLED=True
ADAPTIVE_TIME_BUDGET_SECONDS=180
# The detail model and the final layer skip a photograph over this many pixels (its time grows about 3 s per megapixel); the finishing polish still runs.
ADAPTIVE_DETAIL_MAX_PIXELS=4000000
# A photograph over this is refused at upload before any model runs.
ENHANCEMENT_MAX_INPUT_PIXELS=24000000

# Real background mode (scripts/dev_up.sh sets this itself): the upload answers at once and the progress endpoint moves through the stages.
CELERY_TASK_ALWAYS_EAGER=False
