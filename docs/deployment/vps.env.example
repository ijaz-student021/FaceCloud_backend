# Environment file for the VPS (api.facecloudai.com): /etc/facecloud/facecloud.env, mode 0640 root:facecloud. Names and shapes only: fill every value
# yourself and never commit the filled file. Walkthrough: docs/deployment/VPS_RUNBOOK.md.

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.facecloudai.com

# Secrets: each its own random value (python3 -c "import secrets; print(secrets.token_urlsafe(48))"). Keep a copy in the secret store, apart from the backups.
DJANGO_SECRET_KEY=
IDENTITY_EMBEDDING_KEY=
IMAGE_ENCRYPTION_ENABLED=True
IMAGE_ENCRYPTION_KEY=

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=facecloud
DB_USER=facecloud
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (written out, not left at the development defaults)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CACHE_URL=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# Email (SMTP account name and password are required)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Addresses, CORS and CSRF: the frontend origin only
PUBLIC_BACKEND_URL=https://api.facecloudai.com
FRONTEND_URL=https://www.facecloudai.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://www.facecloudai.com
CSRF_TRUSTED_ORIGINS=https://api.facecloudai.com

# Behind Nginx
TRUST_PROXY_SSL_HEADER=True
TRUSTED_PROXY_COUNT=1
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Privacy policy
BIOMETRIC_CONSENT_REQUIRED=True
FACIAL_DATA_RETENTION_DAYS=365

# Files
STORAGE_BACKEND=filesystem
MEDIA_ROOT=/var/lib/facecloud/media
STATIC_ROOT=/srv/facecloud/static
LOG_FILE=/var/log/facecloud/app.log

# Models: see ec2-small-cpu.env.example for the light profile; anything non-commercial needs an owner's decision first.
# The enhancement engine the whole product was built and tested on (without this line manual "Enhance again" runs the older OpenCV-only policy).
ENHANCEMENT_RENDER_POLICY=adaptive_v1
# Zero-DCE brightens dark photographs (the owner decided on 2026-11-04 to run it: docs/model-licenses/zero-dce-owner-decision.md). Its weights are NON-COMMERCIAL (CC BY-NC 4.0);
# production start-up refuses it unless this is acknowledged, and the acknowledgement is a recorded decision, not a licence. Without Zero-DCE the low-light step falls to a plain OpenCV
# gamma (mean PSNR 13.2 against 18.7 on three dark photographs, docs/deployment/ec2-small-cpu.md). To revert: ZERO_DCE_ENABLED=False and delete the acknowledgement.
ZERO_DCE_ENABLED=True
NONCOMMERCIAL_MODELS_ACKNOWLEDGED=True
# HD_RESTORATION_ENABLED also switches on the compact network that is the final layer of every photograph, and Real-ESRGAN x4plus (about 5 minutes for 0.3 MP on a CPU):
# decide it with the table from scripts/measure_inference.py run on THIS host (docs/deployment/hostinger-readiness-2026-10.md); it is left at its default here.
