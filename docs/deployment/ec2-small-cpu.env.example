# Profile for a small CPU-only EC2 instance (2 vCPU, 4-8 GiB). Copy the lines you need into the instance's .env.
# No PyTorch model is loaded: nothing here needs a GPU, and PyTorch does not even have to be installed.
# Measured on an Apple M1 CPU, not on EC2: re-measure on the instance (docs/deployment/ec2-small-cpu.md).

DJANGO_DEBUG=False
ENHANCEMENT_RENDER_POLICY=adaptive_v1        # opt-in policy; leave lightweight_v1 (OpenCV only) if you do not want the adaptive engine

# Models: only the light, OpenCV-hosted engines.
RETINEXFORMER_ENABLED=False                  # PyTorch, 20 s per megapixel on a CPU
NAFNET_DENOISE_ENABLED=False                 # PyTorch, 15 s per megapixel; noise falls back to OpenCV non-local means
NAFNET_DEBLUR_ENABLED=False                  # PyTorch; motion blur is reported, not corrected
HD_RESTORATION_ENABLED=False                 # Real-ESRGAN: about 5 minutes for 0.3 MP on a CPU
CODEFORMER_ENABLED=False
GFPGAN_ENABLED=False
ZERO_DCE_ENABLED=True                        # low light through OpenCV (0.3 MB ONNX). NON-COMMERCIAL licence, see below
NONCOMMERCIAL_MODELS_ACKNOWLEDGED=False      # production refuses to start with Zero-DCE until a licence decision sets this True
IDENTITY_PROVIDER=sface_2021dec_v1           # light (39 MB, OpenCV); not the ArcFace weights
FACE_DETECTOR_PROVIDER=yunet_v1              # light; not RetinaFace

# Work and memory limits (peak resident memory measured with this profile, whole process, no PyTorch loaded:
# 0.3 MP 0.5 GB, 1.2 MP 1.2 GB, 3.1 MP 1.4 GB, 6.75 MP 1.7 GB).
ENHANCEMENT_MAX_INPUT_PIXELS=8000000         # larger photographs are reduced first; the stored original is never changed
ADAPTIVE_TIME_BUDGET_SECONDS=120
ENHANCEMENT_MODEL_RESIDENCY=single

# Storage: private S3 through the instance's IAM role (leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY unset).
STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=your-private-bucket
AWS_S3_REGION_NAME=your-region
IMAGE_ENCRYPTION_ENABLED=True

# Run image jobs on their own worker, one at a time, so a burst cannot exhaust the instance's memory:
#   celery -A config worker -Q inference --concurrency=1
#   celery -A config worker -Q celery --concurrency=1
ENHANCEMENT_QUEUE_NAME=inference
# Optional: "Save as new version" on its own queue and worker (`celery -A config worker -Q edits --concurrency=1`), so a save never waits behind a batch.
# ENHANCEMENT_EDIT_QUEUE_NAME=edits
