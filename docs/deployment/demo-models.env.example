# Local and demo use of the restoration models. Copy the lines you need into your own .env (never commit .env).
#
# LICENCES (docs/model-licenses/model-set-2026-10.md):
#   NAFNet-GoPro (MIT) and Real-ESRGAN (BSD-3-Clause) are permissive and are on by default.
#   GFPGAN v1.4 and CodeFormer are NON-COMMERCIAL (CodeFormer: S-Lab License 1.0). They are acceptable for a final-year project's local
#   and demo use. The production guard (config/production_guard.py) REFUSES to start with them switched on unless the owner sets
#   NONCOMMERCIAL_MODELS_ACKNOWLEDGED=True deliberately; do not put these lines in a production environment.
#
# Install once, in the environment that runs the server and the worker (Python 3.12):
#   uv pip install --python .venv/bin/python -r requirements-gfpgan.txt einops gdown
#   uv pip uninstall --python .venv/bin/python opencv-python opencv-contrib-python-headless
#   uv pip install --python .venv/bin/python -c requirements-gfpgan-constraints.txt opencv-contrib-python-headless==5.0.0.93
#   python scripts/fetch_models.py --only nafnet,realesrgan,gfpgan,gfpgan_detector,gfpgan_parser,codeformer   # each file is checked against its pinned SHA-256
#   python manage.py check_restoration --verify

NONCOMMERCIAL_MODELS_ACKNOWLEDGED=True

GFPGAN_ENABLED=True
GFPGAN_MODEL_PATH=/absolute/path/to/.runtime/models/gfpgan/GFPGANv1.4.pth
GFPGAN_MODEL_SHA256=e2cd4703ab14f4d01fd1383a8a8b266f9a5833dacee8e6a79d3bf21a1b6be5ad

CODEFORMER_ENABLED=True
CODEFORMER_MODEL_PATH=/absolute/path/to/.runtime/models/codeformer/codeformer.pth
CODEFORMER_MODEL_SHA256=1009e537e0c2a07d4cabce6355f53cb66767cd4b4297ec7a4a64ca4b8a5684b7

NAFNET_DEBLUR_ENABLED=True
HD_RESTORATION_ENABLED=True
