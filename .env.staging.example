# Local staging environment (docker-compose.staging.yml). Copy to .env.staging
# and replace every value marked CHANGE. Never commit .env.staging.
#
# DEBUG stays on for local staging: the production guard (config/production_guard.py)
# requires HTTPS URLs and a real SMTP server, which a local stack does not have.
# Everything else is production-shaped: PostgreSQL, Redis, separate worker and
# beat, a shared cache, no in-process ("eager") tasks.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=CHANGE-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://127.0.0.1:8000

DB_NAME=facecloud_staging
DB_USER=facecloud
DB_PASSWORD=CHANGE-staging-db-password

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CONTACT_RECIPIENT_EMAILS=team@localhost

IDENTITY_EMBEDDING_KEY=CHANGE-another-long-random-string
IMAGE_ENCRYPTION_ENABLED=True
IMAGE_ENCRYPTION_KEY=CHANGE-another-long-random-string

# Models: CPU only inside Docker. Optional PyTorch models stay off unless the
# gfpgan profile is started; colourisation stays off.
ZERO_DCE_ENABLED=True
AI_RESTORATION_ENABLED=True
HD_RESTORATION_ENABLED=False
NAFNET_DEBLUR_ENABLED=False
PUREVISION_ENABLED=False
PURESCALE_ENABLED=False
GFPGAN_ENABLED=False
GFPGAN_QUEUE_ENABLED=False
COLORIZATION_ENABLED=False
